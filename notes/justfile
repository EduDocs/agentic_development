# Convenience recipes for the manuscript.
# Build output lives in the .nel/ container (ADR 0009); this justfile itself
# stays at the project root because `just` only ever searches upward from cwd.
outdir     := ".nel/build"
main       := "main"
open_cmd   := "open"

# Print available recipes (default recipe)
default:
    @just --list

# Compose the standalone aggregate + spine digest (.nel/build/aggregate.tex, .nel/build/spine.md)
compose:
    ./nel compose

# Delegates on purpose. `./nel build` is already self-contained — it needs only
# pdflatex and the project's templates/, no Python engine — so keeping the recipe
# here too meant maintaining the same conditionals twice (bibtex only when
# something is \cite'd; makeindex only when a .idx appeared). They DID drift: the
# absolute BIBINPUTS that a nested output directory requires had to be fixed in
# both copies separately. `nel` is the one implementation.
#
# Compile the manuscript to .nel/build/main.pdf
build:
    ./nel build

# Open the compiled PDF
view: build
    {{open_cmd}} {{outdir}}/{{main}}.pdf

# Run the soft-feedback evaluator (composes, compiles, reviewer panel)
evaluate:
    ./nel evaluate

# Remove build artifacts
clean:
    rm -rf {{outdir}}

# List the papers in the local arXiv library (resources/)
resources:
    #!/usr/bin/env bash
    shopt -s nullglob
    dirs=(resources/arXiv-*/)
    if [ ${#dirs[@]} -eq 0 ]; then
        echo "No papers in resources/ yet — ingest one with the get-arxiv skill."
        exit 0
    fi
    echo "Local arXiv library — ${#dirs[@]} paper(s):"
    for d in "${dirs[@]}"; do
        s="${d}SYNOPSIS.md"
        title=$(sed -n 's/^title:[[:space:]]*//p' "$s" 2>/dev/null | head -1)
        title="${title%\'}"; title="${title#\'}"
        [ -z "$title" ] && title=$(sed -n 's/^# //p' "$s" 2>/dev/null | head -1)
        [ -z "$title" ] && title="(no SYNOPSIS.md)"
        id=$(basename "$d")
        printf '  %-22s %s\n' "${id#arXiv-}" "$title"
    done
    echo "(roles & tags: resources/CATALOG.md)"
