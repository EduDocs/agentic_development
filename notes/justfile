# Build configuration
outdir     := "output"
main       := "notes"
latex      := "pdflatex"
latexflags := "-interaction=nonstopmode -halt-on-error"
open_cmd   := "open"

# Chapter order — mirrors the \include sequence in the main .tex.
md_files := "chapters/preface.md \
chapters/agentic_paradigm.md \
chapters/agentic_rig.md \
chapters/context_engineering.md \
chapters/agentic_coding.md \
chapters/agent_loop.md \
chapters/evaluation.md \
chapters/retrieval.md \
chapters/orchestration.md \
chapters/evolutionary_frameworks.md"

# Print available recipes (default)
default:
    @just --list

# Build either the LaTeX notes or the Markdown sidecars.
#   just build latex   -> output/notes.pdf
#   just build md      -> output/notes_sidecars.pdf
build kind:
    @just _build-{{kind}}

# View either compiled PDF (builds first if needed).
#   just view latex
#   just view md
view kind:
    @just _view-{{kind}}

# --- LaTeX ----------------------------------------------------------------

_build-latex:
    mkdir -p {{outdir}}/chapters
    {{latex}} {{latexflags}} -output-directory={{outdir}} {{main}}.tex
    -cd {{outdir}} && makeindex {{main}}.idx
    {{latex}} {{latexflags}} -output-directory={{outdir}} {{main}}.tex
    {{latex}} {{latexflags}} -output-directory={{outdir}} {{main}}.tex

_view-latex: _build-latex
    {{open_cmd}} {{outdir}}/{{main}}.pdf

# --- Markdown sidecars (future use) ---------------------------------------

_build-md:
    mkdir -p {{outdir}}
    pandoc {{md_files}} \
        --top-level-division=chapter \
        --toc \
        -V geometry:margin=1in \
        -o {{outdir}}/{{main}}_sidecars.pdf

_view-md: _build-md
    {{open_cmd}} {{outdir}}/{{main}}_sidecars.pdf

# --- Housekeeping ---------------------------------------------------------

clean:
    rm -rf {{outdir}}
