# Build configuration for the manuscript (the evolving artifact).
outdir     := "build"
latex      := "pdflatex"
bibtex     := "bibtex"
makeindex  := "makeindex"
latexflags := "-interaction=nonstopmode"
main       := "main"
open_cmd   := "open"

# Print available recipes (default recipe)
default:
    @just --list

# Compose the standalone aggregate + spine digest (build/aggregate.tex, build/spine.md)
compose:
    python3 compose.py

# Full build: pdflatex -> bibtex (only if cited) -> makeindex (only if indexed)
#             -> pdflatex -> pdflatex
# Runs bibtex only when something is actually \cite'd — otherwise bibtex emits a
# degenerate empty thebibliography that breaks pdflatex (mirrors evaluate._compile).
# Runs makeindex only when the first pass actually wrote a .idx, i.e. when the
# document has \makeindex plus at least one \index entry. Without this step a
# manuscript that indexes gets no index at all: \printindex finds no .ind and
# prints nothing, silently, while the log says only "No file main.ind."
build:
    #!/usr/bin/env bash
    set -e
    mkdir -p {{outdir}}
    # \include (unlike \input) writes a per-file .aux mirroring its source path
    # under -output-directory; that dir must exist first (book-class documents,
    # e.g. an adopted manuscript, that \include per chapter). Best-effort scan.
    while IFS= read -r inc; do
        [[ -n "$inc" ]] && mkdir -p "{{outdir}}/$(dirname "$inc")"
    done < <(grep -hoE '\\include\{[^}]+\}' ./*.tex sections/*.tex 2>/dev/null \
              | sed -E 's/\\include\{([^}]+)\}/\1/')
    export TEXINPUTS=.:templates/:
    {{latex}} {{latexflags}} -output-directory={{outdir}} {{main}}.tex
    if grep -qE '\\cite[a-zA-Z]*\{' sections/*.tex main.tex; then
        ( cd {{outdir}} && BIBINPUTS=..:../templates: BSTINPUTS=..:../templates: {{bibtex}} {{main}} ) || true
    else
        rm -f {{outdir}}/{{main}}.bbl
    fi
    if [ -f "{{outdir}}/{{main}}.idx" ]; then
        ( cd {{outdir}} && {{makeindex}} -q {{main}}.idx ) || true
    else
        rm -f {{outdir}}/{{main}}.ind
    fi
    {{latex}} {{latexflags}} -output-directory={{outdir}} {{main}}.tex
    {{latex}} {{latexflags}} -output-directory={{outdir}} {{main}}.tex

# Open the compiled PDF
view: build
    {{open_cmd}} {{outdir}}/{{main}}.pdf

# Run the soft-feedback evaluator (composes, compiles, reviewer panel)
evaluate:
    python3 evaluate.py

# Remove build artifacts
clean:
    rm -rf {{outdir}}

# List the papers in the local arXiv library (resources/)
resources:
    #!/usr/bin/env bash
    shopt -s nullglob
    dirs=(resources/arXiv-*/)
    if [ ${#dirs[@]} -eq 0 ]; then
        echo "No papers in resources/ yet — ingest one with the get-arxiv skill."
        exit 0
    fi
    echo "Local arXiv library — ${#dirs[@]} paper(s):"
    for d in "${dirs[@]}"; do
        s="${d}SYNOPSIS.md"
        title=$(sed -n 's/^title:[[:space:]]*//p' "$s" 2>/dev/null | head -1)
        title="${title%\'}"; title="${title#\'}"
        [ -z "$title" ] && title=$(sed -n 's/^# //p' "$s" 2>/dev/null | head -1)
        [ -z "$title" ] && title="(no SYNOPSIS.md)"
        id=$(basename "$d")
        printf '  %-22s %s\n' "${id#arXiv-}" "$title"
    done
    echo "(roles & tags: resources/CATALOG.md)"
