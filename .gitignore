# ─────────────────────────────────────────────────────────────
# Course working area — ephemeral (keep the folder's README only)
# ─────────────────────────────────────────────────────────────
scratch/*
!scratch/README.md

# Ageation working trees (and their variants, e.g. ageation-french/)
ageation
ageation*

# ─────────────────────────────────────────────────────────────
# Secrets & credentials — never commit
# ─────────────────────────────────────────────────────────────
.env
.env.*
*.local
*.pem
*.key
secrets/
credentials.json
service-account*.json
.anthropic/
.api_keys

# ─────────────────────────────────────────────────────────────
# OS & editor cruft
# ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# ─────────────────────────────────────────────────────────────
# Python (substrate / benchmarks / agent code)
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ─────────────────────────────────────────────────────────────
# Data & model artifacts — large binaries belong outside git
# (commit small sample datasets; keep big dumps & weights out)
# ─────────────────────────────────────────────────────────────
*.ckpt
*.safetensors
*.gguf
*.bin
*.pt
*.onnx
*.parquet
*.h5
# data/            # uncomment if you stage large datasets here

# ─────────────────────────────────────────────────────────────
# Build outputs — markdown is the source of truth; PDFs/slides derive
# ─────────────────────────────────────────────────────────────
build/
dist/
output/
_site/
# Anchored: this is the MkDocs output at the repo root. Unanchored `site/`
# would also swallow notes/site/, which is hand-authored and must be tracked.
/site/
.venv-site/
# Website source: ignore the generated symlinks (regenerate with `just site-links`),
# but keep the real, hand-authored files (the homepage and the brand stylesheet).
site-src/*
!site-src/index.md
!site-src/stylesheets/
# Notes site: the pages and styles are tracked. Two things are not, and both
# are regenerated rather than stored: the concept-map data (CI runs
# `notes_site_data.py` on every deploy) and the book PDF, which lives as an
# asset on the rolling `notes-pdf` release (`just publish-notes-pdf`). A local
# copy of the PDF may appear here from `just notes-serve`; it stays untracked.
notes/site/data/
notes/site/agentic-development-notes.pdf
*.aux
*.toc
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
# *.pdf            # uncomment to keep built PDFs out (docs-as-source)

# ─────────────────────────────────────────────────────────────
# Logs & run artifacts (agent runs, leaderboard temp, traces)
# ─────────────────────────────────────────────────────────────
*.log
logs/
runs/
.cache/
tmp/
